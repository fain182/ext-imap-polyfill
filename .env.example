# Copy to .env to point the integration suite somewhere other than the
# fixtures — a real mailbox, say. Everything is optional; anything left out
# keeps the Greenmail default shown here. A variable already exported in the
# environment wins over this file.

IMAP_POLYFILL_TEST_HOST=127.0.0.1
IMAP_POLYFILL_TEST_PORT=13143
IMAP_POLYFILL_TEST_USER=testuser
IMAP_POLYFILL_TEST_PASSWORD=testpass

# The flags every spec carries. /novalidate-cert is right for a fixture's
# self-signed certificate and wrong for a real one; over TLS use /imap/ssl.
IMAP_POLYFILL_TEST_FLAGS=/imap/novalidate-cert

# POP3 is a separate host on purpose: providers split imap.example.com from
# pop3.example.com. Unset, it follows IMAP_POLYFILL_TEST_HOST.
#IMAP_POLYFILL_TEST_POP3_HOST=
IMAP_POLYFILL_TEST_POP3_PORT=13110
IMAP_POLYFILL_TEST_POP3_FLAGS=/pop3/novalidate-cert

# The implicit-TLS ports, used only by the tests tagged greenmail-only.
IMAP_POLYFILL_TEST_IMAPS_PORT=13993
IMAP_POLYFILL_TEST_POP3S_PORT=13995

# The second fixture, for THREAD, ACL and `make cross-check`.
IMAP_POLYFILL_DOVECOT_HOST=127.0.0.1
IMAP_POLYFILL_DOVECOT_PORT=13144
