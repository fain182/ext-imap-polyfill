{
    "name": "fain182/ext-imap-polyfill",
    "description": "Drop-in polyfill for the imap_* functions removed from PHP core in 8.4, built on directorytree/imapengine",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "imap",
        "polyfill",
        "ext-imap",
        "compatibility",
        "mail"
    ],
    "require": {
        "php": "^8.1",
        "directorytree/imapengine": "^1.25",
        "illuminate/collections": ">=9.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "provide": {
        "ext-imap": "*"
    },
    "autoload": {
        "psr-4": {
            "ImapPolyfill\\": "src/"
        },
        "classmap": [
            "src/Connection/Connection.php"
        ],
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ImapPolyfill\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
